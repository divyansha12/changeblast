{
  "name": "changeblast",
  "version": "1.0.0",
  "description": "Know what your code changes affect. Run smarter tests with AST-based test impact analysis.",
  "type": "module",
  "bin": {
    "changeblast": "./bin/changeblast.js"
  },
  "main": "./src/index.js",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node ./bin/changeblast.js"
  },
  "keywords": [
    "test-impact-analysis",
    "testing",
    "jest",
    "vitest",
    "ast",
    "dependency-graph",
    "selective-testing",
    "git",
    "cli"
  ],
  "author": "Divyanshu Singh",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "picomatch": "^4.0.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  }
}
